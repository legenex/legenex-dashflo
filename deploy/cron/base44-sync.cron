# DashFlo temporary Base44 migration sync.
# Install by merging this line into the dashflo user's crontab on the VPS.
# The VPS timezone is UTC and CRON_TZ pins the schedule even if that changes.
CRON_TZ=UTC
0 0,6,12,18 * * * cd /opt/apps/dashflo && /usr/bin/flock -n /tmp/dashflo-base44-sync.cron.lock /usr/bin/docker compose exec -T app node scripts/base44-sync.mjs sync --trigger scheduled >> /opt/apps/dashflo/base44-sync.log 2>&1
