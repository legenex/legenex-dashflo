{
  "name": "MigrationRequirement",
  "type": "object",
  "properties": {
    "capability_key": {
      "type": "string",
      "description": "Stable slug, e.g. routing.ping_post or ingestion.duplicate_detection"
    },
    "group_key": {
      "type": "string",
      "enum": [
        "ingestion",
        "processing",
        "routing",
        "delivery",
        "buyers",
        "suppliers",
        "reporting",
        "reliability",
        "security",
        "execution"
      ],
      "description": "The ten LeadByte parity capability groups"
    },
    "capability": {
      "type": "string",
      "description": "Short name of the capability"
    },
    "definition": {
      "type": "string",
      "description": "What the capability means in concrete behavioural terms"
    },
    "leadbyte_equivalent": {
      "type": "string",
      "description": "How LeadByte does this today"
    },
    "legenex_implementation": {
      "type": "string",
      "description": "Where this lives in the Legenex app: pages, functions, entities"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_assessed",
        "not_started",
        "in_progress",
        "implemented_unverified",
        "verified",
        "blocked",
        "not_required"
      ],
      "default": "not_assessed"
    },
    "parity": {
      "type": "string",
      "enum": [
        "not_assessed",
        "gap",
        "partial",
        "parity",
        "better",
        "not_required"
      ],
      "default": "not_assessed"
    },
    "required_for_cutover": {
      "type": "boolean",
      "default": true,
      "description": "False marks a capability LeadByte has that Legenex deliberately does not need"
    },
    "migration_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "owner": {
      "type": "string"
    },
    "evidence": {
      "type": "string",
      "description": "What backs the current status. Empty evidence means the status is an assumption."
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "code",
        "runtime",
        "screenshot",
        "data",
        "test",
        "user_feedback",
        "inference",
        "unknown"
      ],
      "default": "unknown",
      "description": "inference and unknown never count as verified"
    },
    "open_gaps": {
      "type": "string",
      "description": "What is still missing"
    },
    "test_coverage": {
      "type": "string",
      "description": "Which automated tests exercise this, or none"
    },
    "reconciliation_result": {
      "type": "string",
      "description": "Outcome of any count, revenue or payout reconciliation for this capability"
    },
    "required_action": {
      "type": "string",
      "description": "The next concrete step"
    },
    "related_page_keys": {
      "type": "string",
      "description": "JSON array of ProgressPage keys that implement this capability"
    },
    "related_function_names": {
      "type": "string",
      "description": "JSON array of backend functions implementing it"
    },
    "release_gate_key": {
      "type": "string",
      "description": "ReleaseGate this capability feeds, when any"
    },
    "signed_off_by": {
      "type": "string"
    },
    "signed_off_at": {
      "type": "string",
      "format": "date-time"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "capability_key",
    "group_key",
    "capability"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}