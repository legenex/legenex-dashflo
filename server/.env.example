# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL the app is reachable at (used in emails, file URLs). Production:
# https://app.dashflo.io. The apex dashflo.io is reserved for marketing.
PUBLIC_BASE_URL=
# Public origin for supplier intake and externally callable functions. In the
# production split-host deployment this is https://api.dashflo.io.
PUBLIC_API_BASE_URL=

# Absolute/relative path to the built frontend. Defaults to ../client/dist.
# CLIENT_DIST=
# UPLOAD_DIR=./uploads

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Either a single DATABASE_URL...
# DATABASE_URL=postgres://user:pass@localhost:5432/dashos
# ...or discrete vars:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=dashos
PGSSL=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Production refuses to start if this is missing, still the placeholder, or
# shorter than 32 characters. Generate a unique random value per environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# One-time token that allows the very first account to be created as owner.
# Required in production: without it the register route refuses to bootstrap,
# so nobody can claim the instance by finding the URL first. Leave empty and
# seed the first account with "npm run seed:admin" instead if you prefer.
OWNER_BOOTSTRAP_TOKEN=

# Extra browser origins allowed to make credentialed requests, comma separated.
# PUBLIC_BASE_URL is always allowed and is usually the only one needed. During
# the controlled hostname transition, list the old app origin here temporarily.
ALLOWED_ORIGINS=

# ── LLM provider (AI Analyst, DataBot, insights) ─────────────────────────────
# LLM_PROVIDER = anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email (password reset / OTP / notifications / contact form) ──────────────
# SMTP_FROM must be a mailbox the SMTP account is authorised to send as. It is
# not the visitor's address and not necessarily the address shown publicly:
# the contact form sets Reply-To to the sender so replies reach them, while the
# From header stays this authorised mailbox. Sending as the visitor would fail
# SPF and DMARC.
#
# SMTP_PORT 587 with SMTP_SECURE=false means STARTTLS. Use port 465 with
# SMTP_SECURE=true for implicit TLS.
#
# With SMTP_HOST empty, mail is logged instead of sent and the contact endpoint
# answers 503 rather than telling a visitor their message was delivered.
#
# Production currently uses Gmail:
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=team@legenex.com
#   SMTP_PASS=<Google App Password, 16 characters, no spaces>
#   SMTP_FROM=team@legenex.com
#   SMTP_FROM_NAME=DashFlo Support
#
# SMTP_PASS is a Google App Password, never the account password, and it exists
# only in the production environment file. It is never committed, never printed,
# never sent to the browser, and never stored in the database.
#
# SMTP_FROM is deliberately the authenticated Gmail mailbox and not
# support@dashflo.io or info@dashflo.io. The dashflo.io domain has catch-all
# INBOUND forwarding, which says nothing about who may send as it: Gmail is not
# authorised to send from those addresses, so using one as From would be a
# forgery that SPF and DMARC exist to reject. Change this only after a verified
# send-as alias is configured in Google Workspace.
#
# Recipients still see DashFlo Support, and CONTACT_RECIPIENT below decides where
# submissions land.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DashFlo <no-reply@localhost>
SMTP_FROM_NAME=DashFlo Support

# ── Public marketing site ────────────────────────────────────────────────────
# Origin of the marketing website. It is allowed to read GET
# /api/auth/session-status (which returns only {"authenticated":true|false})
# and to POST the contact form.
#
# Deliberately separate from ALLOWED_ORIGINS: that list also grants an origin
# CSRF standing for cookie-authenticated writes, which a static public site
# must never have. Do not add the marketing site there.
MARKETING_ORIGIN=https://dashflo.io

# Fixed destination for public contact form submissions. The browser never
# supplies a recipient, so this endpoint cannot be used as a mail relay.
# Inbound catch-all forwarding on dashflo.io delivers this onward.
CONTACT_RECIPIENT=info@dashflo.io

# ── Progress Control Center host ─────────────────────────────────────────────
# Hostname of the owner-only Control Center. It runs the same application and
# the same backend as the operator app, reached through its own nginx server
# block, and the frontend scopes itself by the hostname it was loaded on.
#
# Setting this marks the origin as one of ours for CORS and for the CSRF guard,
# which a cookie-authenticated write from that host needs. It does not grant
# access: the Control Center is owner only and that is decided on the server, in
# lib/progressAccess.js, for every host.
#
# The session cookie is never widened to .dashflo.io. Signing in on this host
# creates a session for this host alone.
PROGRESS_ORIGIN=https://progress.dashflo.io

# ── Performance diagnostics ──────────────────────────────────────────────────
# Log a single line for any request or query slower than these thresholds, in
# milliseconds. Statement text and route only: no parameters, no bodies, no
# caller identity.
SLOW_REQUEST_MS=1500
SLOW_QUERY_MS=300

# ── Third-party integrations (fill in as needed) ─────────────────────────────
LEADBYTE_API_KEY=
LEADBYTE_BASE_URL=
HLR_API_KEY=
HLR_BASE_URL=
TRUSTEDFORM_API_KEY=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
MERCURY_API_KEY=
STRIPE_API_KEY=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_ACCESS_TOKEN=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Migration mirror ─────────────────────────────────────────────────────────
# Shared secret for the read-only migrateSource endpoint, which can stream every
# entity out of this database. There is no default: leave it empty and the
# endpoint refuses all requests. Generate a long random value per environment
# and never commit it.
MIGRATE_SOURCE_SECRET=

# Temporary one-way Base44 -> DashFlo migration sync. Scheduled runs fail
# closed and do nothing unless all three required values are present and the
# enable switch is explicitly on.
BASE44_APP_ID=
BASE44_MIGRATE_SECRET=
BASE44_BASE_URL=
BASE44_SYNC_ENABLED=0
BASE44_TIMEOUT_MS=30000
BASE44_RETRIES=3

# ── Admin seed (optional; used by npm run seed:admin) ────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Global do-not-contact hashing key. Task I2.
# Required. Intake fails closed without it: every post is held with 503 rather
# than delivered, because answering "not suppressed" would contact people who
# opted out. Rotating it later invalidates every stored suppression and the raw
# contacts are deliberately not kept, so a rotation means rebuilding the list
# from its original sources. Decide key management before populating the list.
DNC_HASH_KEY=
